# Copie para .env e ajuste conforme a maquina.

# `latest` nao identifica um build. Fixe a tag (ou um sha256:...) antes de
# publicar qualquer numero — sem isso o resultado nao e' reproduzivel. O digest
# do que rodou de fato fica gravado em results/**/versions.txt a cada execucao;
# copie de la' na hora de fixar.
OPENFGA_TAG=latest
PGCACHE_TAG=latest

# Tetos do container do PgCache. Ele hospeda proxy + um PostgreSQL 18 inteiro,
# entao precisa de pelo menos o mesmo que a origem (cpus 3.0). Com 2.0 ele
# saturou em E3 e o path B mediu o teto do container, nao o cache.
PGCACHE_CPUS=4.0
PGCACHE_MEM=5g

# Controle experimental: fixo em todos os degraus, para a escada medir
# escalabilidade e nao "quanta RAM eu dei ao Postgres".
ORIGIN_SHARED_BUFFERS=1GB
ORIGIN_EFFECTIVE_CACHE=2GB

FGA_MAX_CONNS=50
PGX_EXEC_MODE=cache_statement      # ou simple_protocol se o proxy engasgar

PGCACHE_WORKERS=4
PGCACHE_ALLOWED_TABLES=tuple,authorization_model
PGCACHE_POLICY=clock
PGCACHE_ADMISSION=1
PGCACHE_MEMORY_LIMIT=3221225472
PGCACHE_DISK_LIMIT=10737418240
PGCACHE_LOG_LEVEL=info

FGA_CACHE_TTL=10s
FGA_CACHE_LIMIT=100000

# Portas do host — faixa alta para nao colidir com servicos ja em execucao.
PORT_ORIGIN=15432
PORT_PGCACHE=16432
PORT_PGCACHE_METRICS=19091
PORT_FGA_A=18080
PORT_FGA_B=18090
PORT_FGA_C=18100
PORT_FGA_A_METRICS=21120
PORT_FGA_B_METRICS=21121
PORT_FGA_C_METRICS=21122
PORT_PROM=19090
PORT_GRAFANA=13001
PORT_PGEXP=19187
PORT_CADVISOR=18081
